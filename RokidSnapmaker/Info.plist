<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>RokidSnapmaker connects to your Snapmaker U1 over the local network to read print status and streams it to Rokid glasses via TCP.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_snapmaker._tcp</string>
		<string>_rokidsnapmakeru1._tcp</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
